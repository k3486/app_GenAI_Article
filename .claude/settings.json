{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv *)",
      "Bash(npm *)",
      "Bash(npx shadcn *)",
      "Bash(npx prettier *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(printenv)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^(?!AskUserQuestion$).*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"terminalSequence\":\"\\u0007\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"terminalSequence\":\"\\u0007\"}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/statusline.sh"
  },
  "preferredNotifChannel": "terminal_bell",
  "model": "opusplan",
  "language": "japanese",
  "timeZone": "Asia/Tokyo",
  "timeFormat": "24-hour",
  "maxProseWidth": 100,
  "showThinkingSummaries": true,
  "bashOutputMaxChars": 10000,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["context7", "playwright", "brave-search", "github"],
  "disabledMcpjsonServers": ["aws-docs"]
}
